# Shared by the setup scripts in this folder. No secrets here: this file is committed.
export AWS_DEFAULT_REGION=us-east-1
BUCKET=fair-tourney-media
QUEUE=screenshot-chunks
SCREENSHOT_PREFIX=screenshots/
FUNCTION=process-screenshot-chunk
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5 # placeholder: Floci's stub accepts any ID
LAMBDA_TIMEOUT=60
VISIBILITY_TIMEOUT=360 # 6 x LAMBDA_TIMEOUT
